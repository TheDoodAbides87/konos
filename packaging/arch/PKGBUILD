# Maintainer: TheDoodVibes87 <TheDoodVibes87@pm.me>
#
# Built by packaging/release.sh from a `git archive` of the source tree, then
# published to the [konos] pacman repository (the releases repo on GitHub).
# To build by hand: packaging/release.sh --build-only

pkgname=konos
pkgver=0.7.3beta
pkgrel=1
pkgdesc="Konos Media Player: plays videos, music, discs and streams (libVLC)"
arch=('x86_64')
url="https://github.com/TheDoodAbides87/konos-releases"
license=('MIT')
depends=(
    'qt6-base' 'qt6-svg' 'qt6-wayland' 'taglib' 'hicolor-icon-theme'
    'libvlc' 'vlc-plugins-base' 'vlc-plugin-ffmpeg' 'vlc-plugin-ass'
    'vlc-plugin-freetype'
)
optdepends=(
    'vlc-plugin-pulse: sound through PulseAudio / PipeWire'
    'vlc-plugins-visualization: audio visualizer'
    'vlc-plugin-dvd: DVD playback'
    'vlc-plugin-bluray: Blu-ray playback'
    'libdvdcss: encrypted DVDs'
    'ffmpeg: subtitle timeline for subtitles inside videos'
    'ffmpegthumbnailer: faster video thumbnails'
    'vlc-plugin-x264: Convert / Stream to H.264'
    'vlc-plugin-x265: Convert to H.265'
    'vlc-plugin-ogg: Convert to OGG files'
    'vlc-plugin-theora: Convert to Theora video'
    'vlc-plugin-vorbis: Convert to Ogg Vorbis'
    'vlc-plugin-flac: Convert to FLAC'
    'vlc-plugin-chromecast: Stream to a Chromecast'
    'vlc-plugin-mdns: find Chromecasts on the network'
    'vlc-plugin-zvbi: Open Capture Device (cameras, via v4l2)'
    'vlc-plugins-extra: Open Capture Device (screen, X11 only)'
)
source=("konos-$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!debug')

build() {
    cd "konos-$pkgver"
    mkdir -p build
    cd build
    qmake6 ../konos.pro CONFIG+=omarchy
    make
}

package() {
    cd "konos-$pkgver/build"
    make INSTALL_ROOT="$pkgdir" install
}
